<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Админка — Спикеры</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site">
    <h1>⚙️ Админка спикеров</h1>
    <div class="topbar-admin" style="gap:14px">
      <a href="/">Открыть сайт</a>
      <form method="POST" action="/admin/logout" style="display:inline">
        <button type="submit">Выйти</button>
      </form>
    </div>
  </header>
  <main>
    <a class="btn" href="/admin/new">+ Добавить спикера</a>

    <% if (speakers.length === 0) { %>
      <p class="empty">Спикеров пока нет.</p>
    <% } else { %>
      <table class="admin-list">
        <thead>
          <tr><th>Фото</th><th>Имя</th><th>Должность</th><th>Действия</th></tr>
        </thead>
        <tbody>
          <% speakers.forEach(function(s) { %>
            <tr>
              <td><img src="<%= s.photo %>" alt="<%= s.name %>" /></td>
              <td><%= s.name %></td>
              <td><%= s.title || '' %></td>
              <td class="row-actions">
                <a class="btn" href="/admin/edit/<%= s.id %>">Редактировать</a>
                <form method="POST" action="/admin/delete/<%= s.id %>" onsubmit="return confirm('Удалить спикера <%= s.name %>?')">
                  <button type="submit" class="danger">Удалить</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
